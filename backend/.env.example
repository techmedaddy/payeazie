# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/payeazie

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-this-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3467
NODE_ENV=development

# Payment Gateway Configuration (Mock/External)
GATEWAY_API_URL=http://localhost:9000
GATEWAY_API_KEY=test_key_123

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3467/api/auth/google/callback

# SMTP Configuration (Gmail Example)
# For Gmail: Enable "App Passwords" in your Google Account settings
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# SMTP Configuration (Other providers)
# For Outlook/Hotmail:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587

# For Yahoo:
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587

# For Custom SMTP:
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
