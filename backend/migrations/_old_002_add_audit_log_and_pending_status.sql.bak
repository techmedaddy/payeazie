-- Add payment audit log table for tracking status transitions
CREATE TABLE IF NOT EXISTS payment_audit_log (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    payment_id UUID NOT NULL REFERENCES payments(id) ON DELETE CASCADE,
    from_status VARCHAR(20),
    to_status VARCHAR(20) NOT NULL,
    metadata JSONB,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_payment_audit_payment_id ON payment_audit_log (payment_id);
CREATE INDEX IF NOT EXISTS idx_payment_audit_created_at ON payment_audit_log (created_at);

-- Update default status for new payments to 'pending' instead of 'processing'
ALTER TABLE payments ALTER COLUMN status SET DEFAULT 'pending';

-- Optionally, update existing payments that are still in 'processing' state
-- This is commented out by default to avoid disrupting existing payments
-- UPDATE payments SET status = 'pending' WHERE status = 'processing' AND gateway_charge_id IS NULL;
